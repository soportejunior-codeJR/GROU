# ============================================================
# GROU / web — frontend. Copiar a .env.local y llenar.
# El ETL usa el .env.local de la raiz del proyecto (otras variables).
# Estas mismas 4 van como Environment Variables en Vercel.
# ============================================================

# --- Publicas: viajan al navegador dentro del bundle. ---
# Solo sirven para el login con Google. No dan acceso a los datos: el dataset
# lo entrega /api/datos despues de validar la sesion del lado del servidor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secreta: solo durante el build. ---
# La usa scripts/construir-dataset.mjs para leer v_analisis_postulaciones.
# NUNCA con prefijo NEXT_PUBLIC_: eso la empaqueta en el bundle y queda
# legible en el navegador de cualquiera.
CONV_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
CONV_SUPABASE_SERVICE_ROLE_KEY=
